rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPayloadValid(userId) {
      return request.resource.data.userId == userId &&
             (!('tenantId' in request.resource.data) || request.resource.data.tenantId == userId);
    }
    
    function areCriticalFieldsUnchanged() {
      return (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
             (!('tenantId' in request.resource.data) || request.resource.data.tenantId == resource.data.tenantId) &&
             (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // =========================================================================
    // COLLECTIONS
    // =========================================================================

    // Users & User Profile
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if false;
    }

    match /user_preferences/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /ai_memory/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Offers & Products
    match /offers/{offerId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /products/{productId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /trash_products/{productId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    // Marketplaces & Connections (Integrations / API Keys)
    match /marketplace_connections/{connId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /marketplace_health/{healthId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /marketplace_listings/{listingId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /marketplace_listing_attempts/{attemptId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /marketplace_operation_logs/{logId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /marketplace_recommendations/{recId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /marketplace_trends/{trendId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow delete: if isAuthenticated();
    }

    match /offer_generated_contents/{contentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    // Campaigns & Automations
    match /campaigns/{campaignId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /campaign_events/{eventId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /automation_rules/{ruleId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /automation_executions/{execId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    // Collections, Schedules, Logs & Jobs
    match /collections/{collectionId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /schedules/{scheduleId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /backup_logs/{logId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /system_logs/{logId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /analytics_events/{eventId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /jobs/{jobId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /market_opportunity_history/{historyId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /trend_collection_jobs/{jobId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /prompts/{promptId} {
      allow read: if isOwner(resource.data.userId) || isAdmin(); 
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged() && (!('status' in request.resource.data) || request.resource.data.status == resource.data.status || isAdmin());
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isPayloadValid(request.auth.uid);
      allow update: if isOwner(resource.data.userId) && areCriticalFieldsUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    match /extraction_cache/{cacheId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /analytics/{metricId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
