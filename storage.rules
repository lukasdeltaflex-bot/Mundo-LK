rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Verifica se o usuário está autenticado e se é o dono do path
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Valida se o arquivo é uma imagem e se não excede 5MB
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') 
             && request.resource.size < 5 * 1024 * 1024;
    }

    // =========================================================================
    // PATHS PERMITIDOS
    // =========================================================================

    // Permite upload de avatares apenas pelo próprio usuário, máximo 5MB
    match /users/{userId}/avatars/{imageId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
    }

    // Permite upload de imagens de produtos apenas pelo próprio usuário, máximo 5MB
    match /users/{userId}/products/{imageId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
    }

    // =========================================================================
    // BLOQUEIO GERAL
    // =========================================================================
    
    // Bloqueia qualquer outro acesso não especificado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
